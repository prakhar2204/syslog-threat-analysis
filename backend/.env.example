# SysLog Threat Analysis — Backend Environment Variables
# Copy this file to .env and adjust values as needed.
# For local development, the defaults below work without any changes.

# Application environment: development | production
# Set to 'production' to disable Swagger UI (/docs and /redoc)
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port the backend listens on (Render sets this automatically)
PORT=8000

# Extra CORS origins to allow, comma-separated.
# Not needed for local development (localhost:5173 is allowed by default).
# For production: set this to your Netlify frontend URL.
# Example: CORS_ORIGINS=https://your-app.netlify.app
CORS_ORIGINS=
